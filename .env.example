# Flas CRM — environment variables
#
# Put real values in .env.local  --  NOT in .env.
#
# .env, .env.development and .env.production are TRACKED IN GIT. Anything you
# write into them is committed and pushed. .env.local is covered by the
# "*.local" rule in .gitignore and is the only one of these that stays on your
# machine, so every secret belongs there. Vite's loadEnv() reads it for both
# client and server variables, and it overrides .env, so nothing else needs
# changing.
#
# In production these are set in the host's secret store (Lovable -> project
# settings), never in a file. This example file ships, so it must never contain
# a real value.
#
# Never put SUPABASE_SERVICE_ROLE_KEY in .env. It bypasses RLS completely.
#
# Grouped by what actually breaks without them, so you can go live with the
# first block and add the rest as you turn features on.


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — the app does not function without these
# ─────────────────────────────────────────────────────────────────────────────

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
VITE_SUPABASE_URL=

# The anon / publishable key. Safe to expose to the browser — it is the key RLS
# policies are written against.
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The service-role key. SERVER ONLY — it bypasses RLS entirely, so it must
# never be given a VITE_ prefix and must never reach the browser.
#
# This one is easy to miss and its absence is not obvious: the app still boots
# and the UI still renders, but every server path that uses supabaseAdmin
# returns a 500. That includes the WhatsApp webhook, the lead-capture widget,
# the OAuth callback that finishes connecting a social account, the Paddle
# billing webhook, and the public v1 API. Locally, its absence is exactly why
# /api/public/leads/collect and /api/public/plugin/activate return 500.
SUPABASE_SERVICE_ROLE_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# WhatsApp — needed only for the WhatsApp inbox and webhook
# ─────────────────────────────────────────────────────────────────────────────
# Per-tenant numbers are configured in the app; these are the platform-level
# fallback used before any tenant has its own number.

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Used to verify X-Hub-Signature-256 on inbound webhooks. Without it the
# webhook fails closed and rejects everything with 401 — which is the correct
# behaviour, but it means WhatsApp will appear silent.
WHATSAPP_APP_SECRET=
# The string you type into Meta's webhook setup form.
WHATSAPP_VERIFY_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# Email — password resets, invites, verification
# ─────────────────────────────────────────────────────────────────────────────
# Supabase sends auth mail on its own, but from its shared domain. To send from
# your own address, configure Custom SMTP in the Supabase dashboard
# (Authentication → Emails → SMTP). These variables cover the product's own
# transactional mail, not Supabase's auth mail.

PLATFORM_EMAIL_PROVIDER=
PLATFORM_EMAIL_API_KEY=
# The visible From address, e.g. flas@yourdomain.com
PLATFORM_EMAIL_FROM=


# ─────────────────────────────────────────────────────────────────────────────
# Billing — Paddle
# ─────────────────────────────────────────────────────────────────────────────
# "sandbox" or "production". Getting this wrong points the app at the wrong
# Paddle environment and every checkout silently fails.
PADDLE_ENV=
VITE_PAYMENTS_CLIENT_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# Platform OAuth apps — OPTIONAL, prefer the in-app screen
# ─────────────────────────────────────────────────────────────────────────────
# You usually do NOT need these. Connect & setup → Platform app keys lets each
# workspace paste its own App ID and Secret, stored per tenant, which is the
# better path for a multi-tenant product: one company's keys never serve
# another's, and you do not redeploy to add a platform.
#
# Set them here only if you want a single shared app across every workspace as
# a fallback. Each platform must also whitelist your callback URL:
#   https://<your-domain>/api/public/oauth-callback

META_APP_ID=
META_APP_SECRET=
# Origins a provider may redirect back to after authorization, comma-separated.
# Compared as parsed origins, so "https://flas.example.com" does not match
# "https://flas.example.com.attacker.test". Falls back to PUBLIC_APP_URL, then
# to loopback for development. Set this in production.
OAUTH_ALLOWED_ORIGINS=

# Encryption at rest for social account tokens and platform app secrets.
# Generate a key (never paste one someone sent you):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Set it in Lovable Secrets as  k1:<that value>. To rotate later, put the new
# key first and keep the old one after it: k2:<new>,k1:<old>. Never delete a
# key while values sealed with it remain -- they could not be read back.
# Unset means credentials are stored unencrypted (the health report says so).
TOKEN_ENCRYPTION_KEYS=


GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# Lovable-managed — leave alone unless you know you need them
# ─────────────────────────────────────────────────────────────────────────────
LOVABLE_API_KEY=
LOVABLE_SEND_URL=

# ── Deployment addresses ─────────────────────────────────────────────────────
# The public address of this deployment. Used to build the OAuth callback URL
# and as the fallback sign-in allowlist when OAUTH_ALLOWED_ORIGINS is unset.
# Every provider uses ONE shared callback: <PUBLIC_APP_URL>/api/public/oauth-callback
PUBLIC_APP_URL=https://flas.example.com

# Optional. Meta "Facebook Login for Business" configuration id, when the app
# uses a saved login configuration instead of a plain scope list.
META_LOGIN_CONFIG_ID=

# Legacy single-key alias for TOKEN_ENCRYPTION_KEYS. Prefer TOKEN_ENCRYPTION_KEYS
# (id:base64key pairs) so keys can be rotated without re-encrypting everything.
TOKEN_ENCRYPTION_KEY=
