# Flas CRM — environment variables
#
# Copy to .env for local work. In production these are set in your host's
# secret store (Lovable → project settings), never committed. .env and .env.*
# are gitignored; this file is the only one that ships, so it must never
# contain a real value.
#
# Grouped by what actually breaks without them, so you can go live with the
# first block and add the rest as you turn features on.


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — the app does not function without these
# ─────────────────────────────────────────────────────────────────────────────

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
VITE_SUPABASE_URL=

# The anon / publishable key. Safe to expose to the browser — it is the key RLS
# policies are written against.
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The service-role key. SERVER ONLY — it bypasses RLS entirely, so it must
# never be given a VITE_ prefix and must never reach the browser.
#
# This one is easy to miss and its absence is not obvious: the app still boots
# and the UI still renders, but every server path that uses supabaseAdmin
# returns a 500. That includes the WhatsApp webhook, the lead-capture widget,
# the OAuth callback that finishes connecting a social account, the Paddle
# billing webhook, and the public v1 API. Locally, its absence is exactly why
# /api/public/leads/collect and /api/public/plugin/activate return 500.
SUPABASE_SERVICE_ROLE_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# WhatsApp — needed only for the WhatsApp inbox and webhook
# ─────────────────────────────────────────────────────────────────────────────
# Per-tenant numbers are configured in the app; these are the platform-level
# fallback used before any tenant has its own number.

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Used to verify X-Hub-Signature-256 on inbound webhooks. Without it the
# webhook fails closed and rejects everything with 401 — which is the correct
# behaviour, but it means WhatsApp will appear silent.
WHATSAPP_APP_SECRET=
# The string you type into Meta's webhook setup form.
WHATSAPP_VERIFY_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# Email — password resets, invites, verification
# ─────────────────────────────────────────────────────────────────────────────
# Supabase sends auth mail on its own, but from its shared domain. To send from
# your own address, configure Custom SMTP in the Supabase dashboard
# (Authentication → Emails → SMTP). These variables cover the product's own
# transactional mail, not Supabase's auth mail.

PLATFORM_EMAIL_PROVIDER=
PLATFORM_EMAIL_API_KEY=
# The visible From address, e.g. flas@yourdomain.com
PLATFORM_EMAIL_FROM=


# ─────────────────────────────────────────────────────────────────────────────
# Billing — Paddle
# ─────────────────────────────────────────────────────────────────────────────
# "sandbox" or "production". Getting this wrong points the app at the wrong
# Paddle environment and every checkout silently fails.
PADDLE_ENV=
VITE_PAYMENTS_CLIENT_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# Platform OAuth apps — OPTIONAL, prefer the in-app screen
# ─────────────────────────────────────────────────────────────────────────────
# You usually do NOT need these. Connect & setup → Platform app keys lets each
# workspace paste its own App ID and Secret, stored per tenant, which is the
# better path for a multi-tenant product: one company's keys never serve
# another's, and you do not redeploy to add a platform.
#
# Set them here only if you want a single shared app across every workspace as
# a fallback. Each platform must also whitelist your callback URL:
#   https://<your-domain>/api/public/oauth-callback

META_APP_ID=
META_APP_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# Lovable-managed — leave alone unless you know you need them
# ─────────────────────────────────────────────────────────────────────────────
LOVABLE_API_KEY=
LOVABLE_SEND_URL=
